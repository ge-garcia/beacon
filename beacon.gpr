library project Beacon is

   --  Design rule 5: the in-process backend has no network dependency.
   --  src/ builds anywhere with a tasking runtime. src/net/ pulls in
   --  GNAT.Sockets and is desktop only. Set BEACON_NETWORK=no to leave
   --  it out (embedded builds).
   type Yes_No is ("yes", "no");
   Network : Yes_No := external ("BEACON_NETWORK", "yes");

   case Network is
      when "yes" => for Source_Dirs use ("src", "src/net");
      when "no"  => for Source_Dirs use ("src");
   end case;

   for Library_Name use "beacon";
   for Library_Version use "0.1.0";
   for Library_Kind use "static";
   for Object_Dir use "obj/" & Network;
   for Library_Dir use "lib/" & Network;
   for Create_Missing_Dirs use "True";

   --  -gnatw.X: the board runtime (board/) has No_Exception_Propagation.
   --  There, a failed check calls the last chance handler, and GNAT warns
   --  at each check that can fail. If each caller obeys the
   --  preconditions, the proof shows that no check in Beacon.Queue fails.
   --  Beacon.Topic has no proof. If one of its checks fails, the program
   --  stops. On other runtimes, -gnatw.X has no effect.
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnatVa",
         "-gnatyg", "-gnatyM100", "-g", "-O1", "-fstack-check", "-gnatw.X");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   --  cd prove && alr exec -- gnatprove -P beacon_prove.gpr
   --  Only Beacon and Beacon.Queue carry SPARK_Mode => On.
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=30", "-j0");
   end Prove;

end Beacon;
